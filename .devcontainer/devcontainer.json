{
  "name": "zabbix-monitoring-lab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [80, 10051],
  "portsAttributes": {
    "80": {
      "label": "Zabbix Web UI",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "test -d zabbix-docker || git clone --depth 1 https://github.com/zabbix/zabbix-docker.git",
  "postStartCommand": "cd zabbix-docker && make up DB=pgsql"
}
